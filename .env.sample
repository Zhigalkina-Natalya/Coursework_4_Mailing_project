# Django secret key (замени на свой реальный ключ)
SECRET_KEY=django-insecure-your-secret-key-here
# Debug mode (True для разработки, False для продакшена)
DEBUG=True
# Разрешённые хосты
ALLOWED_HOSTS=127.0.0.1,localhost

# Настройки подключения к PostgreSQL
NAME=mydatabase
USER=mydatabaseuser
PASSWORD=mypassword
HOST=localhost
PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=пароль_приложения_из_Яндекса

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1

CACHE_ENABLED=True
CACHE_TTL=900